# ── Público (pode ir ao browser; protegido por RLS) ──
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# ── SECRETO: só no servidor (EasyPanel env). NUNCA prefixar com NEXT_PUBLIC_ ──
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# String aleatória longa (openssl rand -hex 32) usada para hashear IPs dos scans
IP_HASH_SALT=troque-por-um-valor-aleatorio

# URL pública do site (usada nos QR Codes gerados)
NEXT_PUBLIC_SITE_URL=https://qrauth.seudominio.com

# ── Cloudflare Turnstile (verificação humano/bot) ──
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
